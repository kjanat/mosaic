{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.5",
	"small_model": "anthropic/claude-opus-4-8",
	"experimental": { "batch_tool": true },
	"username": "{env:USER}",
	"formatter": {
		"dprint": {
			"command": ["dprint", "fmt", "$FILE"],
			"extensions": [".sh", ".bash", ".toml", ".svg", ".json", ".rs", ".md", ".ts", ".mts", ".cts", ".js", ".mjs", ".cjs", ".yml", ".yaml"],
		},
	},
}
