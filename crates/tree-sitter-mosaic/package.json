{
	"name": "tree-sitter-mosaic",
	"version": "0.0.0",
	"description": "Mosaic grammar for tree-sitter",
	"type": "module",
	"main": "bindings/node",
	"types": "bindings/node",
	"files": [
		"grammar.js",
		"tree-sitter.json",
		"binding.gyp",
		"bindings/node/*",
		"queries/*",
		"src/**"
	],
	"exports": {
		".": {
			"types": "./bindings/node/index.d.ts",
			"default": "./bindings/node/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate": "tree-sitter generate",
		"test": "tree-sitter test",
		"parse": "tree-sitter parse",
		"playground": "tree-sitter playground --quiet"
	},
	"devDependencies": {
		"node-gyp-build": "^4.8.4",
		"tree-sitter": "^0.25.0",
		"tree-sitter-cli": "^0.26.0"
	}
}
