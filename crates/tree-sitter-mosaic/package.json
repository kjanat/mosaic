{
	"name": "tree-sitter-mosaic",
	"version": "0.0.0",
	"description": "Mosaic grammar for tree-sitter",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/mosaic.git",
		"directory": "crates/tree-sitter-mosaic"
	},
	"type": "module",
	"exports": {
		".": "./bindings/node/index.js",
		"./package.json": "./package.json"
	},
	"main": "bindings/node",
	"files": [
		"grammar.js",
		"tree-sitter.json",
		"binding.gyp",
		"bindings/node/*",
		"queries/*",
		"scripts/*",
		"src/**"
	],
	"scripts": {
		"generate": "tree-sitter generate",
		"postinstall": "node scripts/ensure-native.mjs",
		"parse": "tree-sitter parse",
		"playground": "tree-sitter playground --quiet",
		"test": "tree-sitter test"
	},
	"devDependencies": {
		"@types/node": "^25.7.0",
		"node-addon-api": "^8.7.0",
		"node-gyp-build": "^4.8.4",
		"tree-sitter": "^0.25.0",
		"tree-sitter-cli": "^0.26.0",
		"typescript": "^6.0.3"
	}
}
