{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"bindings/node/**/*.js",
		"bindings/node/**/*.d.ts"
	],
	"exclude": [
		"node_modules"
	]
}
