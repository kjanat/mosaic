{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat/configs/dprint.remote.json",
	"markdown": { "textWrap": "always", "lineWidth": 100 },
	"json": { "lineWidth": 140 },
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{ "command": "tombi format - --stdin-filename {{file_path}}", "exts": ["toml"] }, // If missing, run bunx tombi, or uvx tombi, o
			{ "command": "rustfmt", "exts": ["rs"], "cacheKeyFiles": ["rustfmt.toml"] },
			{ "command": "just --dump --justfile {{file_path}}", "fileNames": ["justfile"] },
		],
	},
	"excludes": [
		"**/node_modules",
		"**/{*-,bun}lock(.*)?",
		"**/target",
		// tree-sitter generated artifacts: re-emitted by `tree-sitter generate`
		// with its own style, so leave them alone to keep CI fmt stable.
		"crates/tree-sitter-mosaic/src/parser.c",
		"crates/tree-sitter-mosaic/src/grammar.json",
		"crates/tree-sitter-mosaic/src/node-types.json",
	],
	"plugins": [
		"https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
	],
}
