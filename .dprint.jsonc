{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat/configs/dprint.remote.json",
	"markdown": { "textWrap": "always", "lineWidth": 100 },
	"json": { "lineWidth": 140 },
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "tombi format - --stdin-filename {{file_path}}",
				"exts": ["toml"],
				"cacheKeyFiles": ["tombi.toml"],
				"setupCommand": "npm i -g tombi"
			},
			{
				"command": "rustfmt",
				"exts": ["rs"],
				"cacheKeyFiles": ["rustfmt.toml", "rust-toolchain.toml", ".cargo/config.toml", ".cargo/nightly.toml"]
			},
			{
				"command": "just --dump --justfile {{file_path}}",
				"fileNames": ["justfile"],
				"setupCommand": "npm i -g rust-just"
			},
		],
	},
	"excludes": [
		"**/node_modules",
		"**/{*-,bun}lock(.*)?",
		"**/target",
		// tree-sitter generated artifacts: re-emitted by `tree-sitter generate`
		// with its own style, so leave them alone to keep CI fmt stable.
		"crates/tree-sitter-mosaic/src/parser.c",
		"crates/tree-sitter-mosaic/src/grammar.json",
		"crates/tree-sitter-mosaic/src/node-types.json",
		".github/actions/pages/index.html",
	],
	"plugins": [
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
	],
}
